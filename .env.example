# ===== Smart Registrar configuration =====
# Copy this file to ".env" and adjust the values if needed.

# Port the server listens on (frontend opens at http://<PC-IP>:PORT)
PORT=3000

# Address to bind. 0.0.0.0 = reachable from other devices on the Wi-Fi network
HOST=0.0.0.0

# Secret used to sign login tokens. CHANGE THIS to any random text.
JWT_SECRET=change-me-to-a-long-random-secret

# SQLite database file (created automatically on first run)
DB_PATH=./database/smart-registrar.db

# First run: 0 = only admin + document types + schedule slots (NO example students/data).
# Set to 1 only if you want sample students/requests for demo classrooms.
SEED_SAMPLE=0

# ===== Email (OTP + status/progress notifications) =====
# Ginagamit sa registration/change-password OTP at sa mga email kapag
# nagbago ang status ng request/appointment (Processing, Ready for Pickup, etc.).
# Kapag walang provider, dev mode lang: naka-log sa console ang mga email.
#
# OPTION A — Brevo HTTP API (recommended kapag Render Free: HTTPS lang, hindi SMTP)
# Gumawa ng free account sa https://www.brevo.com, kunin ang API key sa
# Settings > SMTP & API > API Keys, at i-verify ang sender email.
BREVO_API_KEY=
MAIL_FROM=
MAIL_FROM_NAME=Smart Registrar
#
# OPTION B — Gmail SMTP (localhost / paid hosts lang; blocked sa Render Free)
# Kailangan ng App Password (hindi ang normal password).
# Gumawa sa: https://myaccount.google.com/apppasswords (i-enable muna ang 2FA)
GMAIL_USER=
GMAIL_APP_PASSWORD=
#
# Kung pareho ang naka-set, Brevo ang gagamitin.
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
